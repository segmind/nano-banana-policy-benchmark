# Copy to .env and fill in locally. Never commit credentials.
# Use: python3 benchmark.py run --env-file .env --provider all --model nano-banana-2
# Exported values take precedence. Values are literal, with no shell expansion.
SEGMIND_API_KEY=
FAL_KEY=
GOOGLE_CLOUD_PROJECT=
# Optional: use a short-lived token, or let the runner use gcloud auth.
GOOGLE_ACCESS_TOKEN=
